<?xml version="1.0" encoding="UTF-8"?>
<ssd:SystemStructure xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription"
  xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" version="1.0" name="SMAVETransformed">
  <ssd:System name="Transformed">
    <ssd:Elements>
      <ssd:Component name="A" source="resources/a.fmu" type="application/x-fmu-sharedlibrary">
        <ssd:Connectors>
          <ssd:Connector name="y" kind="output"><ssc:Real unit="degC"/></ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="B" source="resources/b.fmu" type="application/x-fmu-sharedlibrary">
        <ssd:Connectors>
          <ssd:Connector name="u" kind="input"><ssc:Real unit="K"/></ssd:Connector>
          <ssd:Connector name="y" kind="output"><ssc:Real/></ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="A" startConnector="y" endElement="B" endConnector="u">
        <ssc:LinearTransformation factor="0.5" offset="1"/>
      </ssd:Connection>
    </ssd:Connections>
  </ssd:System>
  <ssd:Units>
    <ssc:Unit name="degC"><ssc:BaseUnit K="1" offset="0"/></ssc:Unit>
    <ssc:Unit name="K"><ssc:BaseUnit K="1"/></ssc:Unit>
  </ssd:Units>
</ssd:SystemStructure>
