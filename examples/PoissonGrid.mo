model PoissonGrid
  parameter Real b1 = 1.0;
  parameter Real b2 = 1.0;
  parameter Real b3 = 1.0;
  parameter Real b4 = 1.0;
  parameter Real b5 = 1.0;
  parameter Real b6 = 1.0;
  parameter Real b7 = 1.0;
  parameter Real b8 = 1.0;
  parameter Real b9 = 1.0;
  parameter Real b10 = 1.0;
  parameter Real b11 = 1.0;
  parameter Real b12 = 1.0;
  parameter Real b13 = 1.0;
  parameter Real b14 = 1.0;
  parameter Real b15 = 1.0;
  parameter Real b16 = 1.0;
  parameter Real b17 = 1.0;
  parameter Real b18 = 1.0;
  parameter Real b19 = 1.0;
  parameter Real b20 = 1.0;
  parameter Real b21 = 1.0;
  parameter Real b22 = 1.0;
  parameter Real b23 = 1.0;
  parameter Real b24 = 1.0;
  parameter Real b25 = 1.0;
  Real x1(start = 0.0);
  Real x2(start = 0.0);
  Real x3(start = 0.0);
  Real x4(start = 0.0);
  Real x5(start = 0.0);
  Real x6(start = 0.0);
  Real x7(start = 0.0);
  Real x8(start = 0.0);
  Real x9(start = 0.0);
  Real x10(start = 0.0);
  Real x11(start = 0.0);
  Real x12(start = 0.0);
  Real x13(start = 0.0);
  Real x14(start = 0.0);
  Real x15(start = 0.0);
  Real x16(start = 0.0);
  Real x17(start = 0.0);
  Real x18(start = 0.0);
  Real x19(start = 0.0);
  Real x20(start = 0.0);
  Real x21(start = 0.0);
  Real x22(start = 0.0);
  Real x23(start = 0.0);
  Real x24(start = 0.0);
  Real x25(start = 0.0);
equation
  4*x1 - x6 - x2 = b1;
  4*x2 - x7 - x1 - x3 = b2;
  4*x3 - x8 - x2 - x4 = b3;
  4*x4 - x9 - x3 - x5 = b4;
  4*x5 - x10 - x4 = b5;
  4*x6 - x1 - x11 - x7 = b6;
  4*x7 - x2 - x12 - x6 - x8 = b7;
  4*x8 - x3 - x13 - x7 - x9 = b8;
  4*x9 - x4 - x14 - x8 - x10 = b9;
  4*x10 - x5 - x15 - x9 = b10;
  4*x11 - x6 - x16 - x12 = b11;
  4*x12 - x7 - x17 - x11 - x13 = b12;
  4*x13 - x8 - x18 - x12 - x14 = b13;
  4*x14 - x9 - x19 - x13 - x15 = b14;
  4*x15 - x10 - x20 - x14 = b15;
  4*x16 - x11 - x21 - x17 = b16;
  4*x17 - x12 - x22 - x16 - x18 = b17;
  4*x18 - x13 - x23 - x17 - x19 = b18;
  4*x19 - x14 - x24 - x18 - x20 = b19;
  4*x20 - x15 - x25 - x19 = b20;
  4*x21 - x16 - x22 = b21;
  4*x22 - x17 - x21 - x23 = b22;
  4*x23 - x18 - x22 - x24 = b23;
  4*x24 - x19 - x23 - x25 = b24;
  4*x25 - x20 - x24 = b25;
end PoissonGrid;
