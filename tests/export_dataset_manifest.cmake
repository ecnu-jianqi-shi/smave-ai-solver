file(READ "${SNAPSHOT}" snapshot)
if(NOT DEFINED DATASET_ID OR DATASET_ID STREQUAL "")
    set(DATASET_ID phase7-validation-scenarios)
endif()
string(REGEX MATCH "version: ([0-9a-f]+)" _ "${snapshot}")
set(version "${CMAKE_MATCH_1}")
string(LENGTH "${version}" length)
if(NOT length EQUAL 64)
    message(FATAL_ERROR "dataset snapshot lacks SHA-256 version")
endif()
set(source "${STORE}/datasets/${DATASET_ID}/${version}/dataset.manifest")
if(NOT EXISTS "${source}")
    message(FATAL_ERROR "dataset manifest is absent from immutable store")
endif()
file(COPY_FILE "${source}" "${OUTPUT}" ONLY_IF_DIFFERENT)
