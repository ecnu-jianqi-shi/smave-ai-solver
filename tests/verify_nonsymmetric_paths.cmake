foreach(required OUTPUT REPEAT_OUTPUT TRACE_PATH REPEAT_TRACE_PATH
        PIVOT_OUTPUT PIVOT_REPEAT_OUTPUT PIVOT_TRACE_PATH PIVOT_REPEAT_TRACE_PATH
        SPARSE_DIRECT_EVIDENCE)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "missing non-symmetric path artifact: ${required}")
    endif()
endforeach()
file(READ "${SPARSE_DIRECT_EVIDENCE}" SPARSE_DIRECT_EVIDENCE_TEXT)
file(READ "${TRACE_PATH}" TRACE)
file(READ "${REPEAT_TRACE_PATH}" REPEAT_TRACE)
file(READ "${PIVOT_TRACE_PATH}" PIVOT_TRACE)
file(READ "${PIVOT_REPEAT_TRACE_PATH}" PIVOT_REPEAT_TRACE)
string(STRIP "${TRACE}" TRACE)
string(STRIP "${REPEAT_TRACE}" REPEAT_TRACE)
string(STRIP "${PIVOT_TRACE}" PIVOT_TRACE)
string(STRIP "${PIVOT_REPEAT_TRACE}" PIVOT_REPEAT_TRACE)
include("${CMAKE_CURRENT_LIST_DIR}/verify_nonsymmetric.cmake")
